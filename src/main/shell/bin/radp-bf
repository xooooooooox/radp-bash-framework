#!/usr/bin/env bash
set -euo pipefail

__radp_bf_usage() {
  cat <<'USAGE'
radp-bf - radp-bash-framework CLI

Usage:
  radp-bf [options] <command> [args...]

Global options:
  -v, --verbose         Enable verbose output (info logs)
  --debug               Enable debug output (debug logs)
  -h, --help            Show this help

Commands:
  new <name> [dir]      Create a new CLI project based on radp-bash-framework
  upgrade [dir] [opts]  Upgrade an existing CLI project to latest scaffold
  path <name>           Print framework path (init|launcher|root)
  resolve-root <path>   Resolve project root from script path (for entry scripts)
  version               Show version
  help                  Show this help

Upgrade options:
  --dry-run             Show changes without applying
  --force               Overwrite user-modified files
  --diff                Show file differences
  Components: entry, ide, gitignore, all (default: all)

Path names:
  init       Path to init.sh (framework initializer)
  launcher   Path to launcher.sh (app launcher)
  root       Framework root directory

Examples:
  radp-bf new my-cli
  radp-bf new my-cli ~/projects
  radp-bf upgrade                     # Upgrade current directory
  radp-bf upgrade ./my-cli --dry-run  # Preview changes
  radp-bf -v upgrade .                # Upgrade with verbose output
  radp-bf --debug upgrade .           # Upgrade with debug output
  source "$(radp-bf path init)" "$@"
  export RADP_APP_ROOT="$(radp-bf resolve-root "${BASH_SOURCE[0]}")"
  source "$(radp-bf path launcher)" "$@"
USAGE
}

# 解析 radp-bf 自身的 bin 目录（处理 symlink）
__radp_bf_bin_dir() {
  local src="${BASH_SOURCE[0]}"

  # 如果是通过相对路径调用, 得到其绝对路径
  if [[ "${src}" != /* ]]; then
    src="$(cd -P -- "$(dirname -- "${src}")" && pwd)/$(basename -- "${src}")"
  fi

  # 解决符号链接, 获取其真实绝对路径
  local dir
  while [[ -L "${src}" ]]; do
    dir="$(cd -P -- "$(dirname -- "${src}")" && pwd)"
    src="$(readlink "${src}")"
    [[ "${src}" != /* ]] && src="${dir}/${src}"
  done

  cd -P -- "$(dirname -- "${src}")" && pwd
}

# 解析任意脚本的项目根目录（处理 symlink）
# 用于简化入口脚本中的 RADP_APP_ROOT 计算
__radp_bf_resolve_root() {
  local src="$1"

  # 如果是相对路径，转为绝对路径
  if [[ "${src}" != /* ]]; then
    src="$(cd -P -- "$(dirname -- "${src}")" && pwd)/$(basename -- "${src}")"
  fi

  # 解决符号链接
  local dir
  while [[ -L "${src}" ]]; do
    dir="$(cd -P -- "$(dirname -- "${src}")" && pwd)"
    src="$(readlink "${src}")"
    [[ "${src}" != /* ]] && src="${dir}/${src}"
  done

  # 返回 bin 目录的父目录（即项目根目录）
  local bin_dir
  bin_dir="$(cd -P -- "$(dirname -- "${src}")" && pwd)"
  dirname "$bin_dir"
}

__radp_bf_setup() {
  local bin_dir
  bin_dir=$(__radp_bf_bin_dir)

  local project_src_root
  project_src_root=$(dirname "$bin_dir")

  # shellcheck source=../framework/init.sh
  source "$project_src_root"/framework/init.sh "$@"
}

__radp_bf_path() {
  case "${1:-}" in
  init)
    echo "${gr_fw_root_path}/init.sh"
    ;;
  launcher)
    echo "${gr_fw_root_path}/launcher.sh"
    ;;
  root)
    echo "${gr_fw_root_path}"
    ;;
  "")
    echo "radp-bf path: name required" >&2
    echo "Available: init, launcher, root" >&2
    return 1
    ;;
  *)
    echo "radp-bf path: unknown name '${1}'" >&2
    echo "Available: init, launcher, root" >&2
    return 1
    ;;
  esac
}

__radp_bf_main() {
  # 加载框架
  __radp_bf_setup "$@"

  case "${1:-}" in
  help | -h | --help | "")
    __radp_bf_usage
    return 0
    ;;
  version | --version)
    radp_get_fw_install_version
    return 0
    ;;
  path)
    shift
    __radp_bf_path "${1:-}"
    return $?
    ;;
  resolve-root)
    shift
    if [[ -z "${1:-}" ]]; then
      echo "radp-bf resolve-root: script path required" >&2
      echo "Usage: radp-bf resolve-root <script-path>" >&2
      return 1
    fi
    __radp_bf_resolve_root "$1"
    return $?
    ;;
  new)
    shift
    if [[ -z "${1:-}" ]]; then
      echo "radp-bf new: project name required" >&2
      echo "Usage: radp-bf new <project-name> [target-dir]" >&2
      return 1
    fi
    radp_cli_scaffold_new "$@"
    return $?
    ;;
  upgrade)
    shift
    radp_cli_upgrade "$@"
    return $?
    ;;
  *)
    echo "radp-bf: unknown command '${1}'" >&2
    echo "Run 'radp-bf help' for usage." >&2
    return 1
    ;;
  esac
}

# 解析全局选项（在加载框架前处理）
__radp_bf_parse_global_opts() {
  local -a remaining_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -v | --verbose)
      export GX_RADP_FW_LOG_CONSOLE_ENABLED=true
      export GX_RADP_FW_LOG_LEVEL=info
      shift
      ;;
    --debug)
      export GX_RADP_FW_LOG_CONSOLE_ENABLED=true
      export GX_RADP_FW_LOG_LEVEL=debug
      shift
      ;;
    *)
      remaining_args+=("$1")
      shift
      ;;
    esac
  done

  # 返回剩余参数
  printf '%s\n' "${remaining_args[@]}"
}

# 默认禁用日志和 banner
GX_RADP_FW_LOG_CONSOLE_ENABLED=${GX_RADP_FW_LOG_CONSOLE_ENABLED:-false}
GX_RADP_FW_LOG_FILE_ENABLED=${GX_RADP_FW_LOG_FILE_ENABLED:-false}

# 解析全局选项并获取剩余参数
mapfile -t __radp_bf_args < <(__radp_bf_parse_global_opts "$@")

__radp_bf_main "${__radp_bf_args[@]}"
