#!/usr/bin/env bash
set -euo pipefail

# 解析脚本真实路径（用于定位本地 radp-bf）
__resolve_bin_dir() {
  local src="${BASH_SOURCE[0]}"
  local dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

# 开发模式：使用框架源码中的 radp-bf
__bin_dir="$(__resolve_bin_dir)"
__radp_bf="$__bin_dir/../../../../main/shell/bin/radp-bf"

if [[ ! -x "$__radp_bf" ]]; then
  echo "Error: radp-bf not found at $__radp_bf" >&2
  exit 1
fi

# 解析项目根目录并启动
export RADP_APP_ROOT="$("$__radp_bf" resolve-root "${BASH_SOURCE[0]}")"
# shellcheck source=../../../../main/shell/framework/launcher.sh
source "$("$__radp_bf" path launcher)" "$@"
